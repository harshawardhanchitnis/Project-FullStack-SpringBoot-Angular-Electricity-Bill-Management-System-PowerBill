{
  "uid": "gridiq-overview",
  "title": "PowerBill GridIQ \u00b7 Platform overview",
  "tags": [
    "gridiq"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Bills issued (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "gridiq-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gridiq-prometheus"
          },
          "expr": "sum(increase(powerbill_bills_generated_total[24h]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Payments settled (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "gridiq-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "gridiq-prometheus"
          },
          "expr": "sum(increase(powerbill_payments_settled_total[24h]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Amount settled (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "gridiq-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "decimals": 0
        },

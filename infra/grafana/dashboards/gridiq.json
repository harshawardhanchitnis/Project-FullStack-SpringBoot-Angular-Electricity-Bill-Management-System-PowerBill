          },
          "expr": "sum(increase(powerbill_payments_settled_amount_inr_total[24h]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Anomalies detected (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "gridiq-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"

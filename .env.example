# Copy to .env (ignored by Git). Leave secrets empty in development: Compose generates local credentials.
WEB_PORT=8080
MAILPIT_PORT=8025
APP_PROFILE=dev
COMPOSE_BIND_ADDRESS=127.0.0.1
DB_NAME=powerbill
DB_USER=powerbill
DB_PASSWORD=
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=
PUBLIC_APP_URL=

# Demo data: set DEMO_MODE=true and choose a local password of 12-128 characters for all demo accounts.
DEMO_MODE=false
DEMO_PASSWORD=

# Required outside the dev profile: 64 hex characters for JWT_SECRET, 32+ characters for the webhook secret.
JWT_SECRET=
PAYMENT_WEBHOOK_SECRET=
INTERNAL_ML_API_KEY=

# Energy Copilot provider: deterministic (default), ollama, openai or gemini. LLM_API_KEY is for openai or gemini.
COPILOT_PROVIDER=deterministic
LLM_API_KEY=
OLLAMA_URL=
OLLAMA_MODEL=

# Observability profile (docker-compose.observability.yml)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=
